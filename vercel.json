{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "excludeFiles": "{tests/**,.github/**,.vercel/**,.freebuff/**,__pycache__/**,.venv/**,venv/**,env/**,*.py[cod],*.log,data/**,Dockerfile,.dockerignore,.vercelignore,.gitignore,.gitattributes,requirements-dev.txt,build_css.py,run.bat,run.sh,README.md,LICENSE}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
